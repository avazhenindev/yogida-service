# Copy this file to /home/yogida/meditation-service/.env on the Linode/Akamai host.
# Do not commit real production secrets.

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/api

SPRING_DATASOURCE_URL=jdbc:postgresql://postgres-host:5432/meditation
SPRING_DATASOURCE_USERNAME=backend
SPRING_DATASOURCE_PASSWORD=change-me
SPRING_JPA_SHOW_SQL=false

CLOUDFLARE_R2_ACCOUNT_ID=change-me
CLOUDFLARE_R2_ACCESS_KEY_ID=change-me
CLOUDFLARE_R2_SECRET_ACCESS_KEY=change-me
CLOUDFLARE_R2_BUCKET=change-me

APP_AUDIO_PRESIGNED_URL_DURATION_MINUTES=60
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0

# Public bucket root only. The app appends the object key ("pictures/<uuid>-<name>"), and this
# must be an r2.dev or custom domain bound to the bucket — the S3 API endpoint needs SigV4.
CLOUDFLARE_R2_PUBLIC_PICTURE_BASE_URL=https://pub-<hash>.r2.dev

APP_SECURITY_JWT_AUDIENCE=yogida
APP_SECURITY_JWT_ISSUER=https://yogida.org/zxcasdqwe/realms/yogida

# RevenueCat integration
APP_REVENUECAT_ENTITLEMENT_ID="Yogida Pro"
# Shared secret mirrored in the RevenueCat dashboard webhook Authorization header
APP_REVENUECAT_WEBHOOK_AUTH_TOKEN=change-me
# Secret API key (sk_...) for the Subscriber API reconciliation job
APP_REVENUECAT_API_KEY=change-me
APP_REVENUECAT_API_BASE_URL=https://api.revenuecat.com/v1

# Entitlement freshness. The cache is in-memory and per-instance; the projection is the
# durable backstop that survives a restart and covers a webhook that never arrived.
APP_REVENUECAT_ENTITLEMENT_CACHE_TTL=24h
APP_REVENUECAT_PROJECTION_MAX_AGE=24h
# How long processed webhook event ids are kept for deduplicating RevenueCat retries.
APP_REVENUECAT_WEBHOOK_LEDGER_RETENTION=30d
# Suppresses repeat RevenueCat calls for a user right after one failed.
APP_REVENUECAT_OUTAGE_SUPPRESSION=30s
