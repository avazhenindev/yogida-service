# Copy this file to /home/yogida/meditation-service/.env on the Linode/Akamai host.
# Do not commit real production secrets.

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/api

SPRING_DATASOURCE_URL=jdbc:postgresql://postgres-host:5432/meditation
SPRING_DATASOURCE_USERNAME=backend
SPRING_DATASOURCE_PASSWORD=change-me
SPRING_JPA_SHOW_SQL=false

CLOUDFLARE_R2_ACCOUNT_ID=change-me
CLOUDFLARE_R2_ACCESS_KEY_ID=change-me
CLOUDFLARE_R2_SECRET_ACCESS_KEY=change-me
CLOUDFLARE_R2_BUCKET=change-me

APP_AUDIO_PRESIGNED_URL_DURATION_MINUTES=60
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0

# application.properties defaults this to DEBUG, which logs every controller argument and
# response body — emails and presigned URLs included. Docker pins INFO; production must too.
LOGGING_LEVEL_COM_YOGIDA_MEDITATION=INFO

# Public bucket root only. The app appends the object key ("pictures/<uuid>-<name>"), and this
# must be an r2.dev or custom domain bound to the bucket — the S3 API endpoint needs SigV4.
CLOUDFLARE_R2_PUBLIC_PICTURE_BASE_URL=https://pub-<hash>.r2.dev

APP_SECURITY_JWT_AUDIENCE=yogida
# Both issuers are required. application.properties gives them no default on purpose, so a
# host built from this template with either one unset refuses to start and names the property.
APP_SECURITY_JWT_ISSUER=https://yogida.org/yogida/zxcasdqwe/realms/yogida
APP_SECURITY_JWT_ADMIN_ISSUER=https://yogida.org/yogida/zxcasdqwe/realms/yogida-admin
# The realms' URLs before the move under /yogida. Tokens Keycloak minted before cutover.sh
# switched KC_HOSTNAME still carry these, so they are accepted until they expire. Remove both
# once the cutover is older than the access-token lifespan of both realms.
APP_SECURITY_JWT_PREVIOUS_ISSUER=https://yogida.org/zxcasdqwe/realms/yogida
APP_SECURITY_JWT_PREVIOUS_ADMIN_ISSUER=https://yogida.org/zxcasdqwe/realms/yogida-admin

# RevenueCat integration
#
# NOTE: this disagrees with every other declaration of the same id — the root .env.example,
# application.properties' default and yogida-ui/app.json all say `premium`. Only the RevenueCat
# dashboard settles which is correct, and the root template states the invariant: it must match
# the id the mobile app looks up in customerInfo.entitlements.active, or a paying user reads as
# free. Confirm and make all four agree.
APP_REVENUECAT_ENTITLEMENT_ID="Yogida Pro"
# Shared secret mirrored in the RevenueCat dashboard webhook Authorization header
APP_REVENUECAT_WEBHOOK_AUTH_TOKEN=change-me
# Secret API key (sk_...) for the Subscriber API reconciliation job
APP_REVENUECAT_API_KEY=change-me
APP_REVENUECAT_API_BASE_URL=https://api.revenuecat.com/v1

# Entitlement freshness. The cache is in-memory and per-instance; the projection is the
# durable backstop that survives a restart and covers a webhook that never arrived.
APP_REVENUECAT_ENTITLEMENT_CACHE_TTL=24h
APP_REVENUECAT_PROJECTION_MAX_AGE=24h
# How long processed webhook event ids are kept for deduplicating RevenueCat retries.
APP_REVENUECAT_WEBHOOK_LEDGER_RETENTION=30d
# Suppresses repeat RevenueCat calls for a user right after one failed.
APP_REVENUECAT_OUTAGE_SUPPRESSION=30s

# Entitlement events
#
# Every RevenueCat event for a known user is forwarded to the app over SSE regardless of these;
# they only decide whether the app may show a banner for it. Set the sandbox flag to false to
# silence banners from TestFlight and App Review purchases, which are SANDBOX events. Both must be
# true or false: an empty value stops startup.
APP_ENTITLEMENT_EVENTS_BANNER_ENABLED=true
APP_ENTITLEMENT_EVENTS_SANDBOX_BANNER_ENABLED=true
